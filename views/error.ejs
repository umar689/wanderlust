<% layout("/layouts/boilerplate") %>
<main class="wander-error-page">
  <div class="wander-error-card" role="alert">
    <span class="wander-error-icon" aria-hidden="true"><i class="fa-solid fa-compass"></i></span>
    <span class="wander-error-kicker">A SMALL DETOUR</span>
    <h1>Well, this is unexpected.</h1>
    <p><%= message %></p>
    <a href="/listings" class="pill-button pill-button-dark">Back to exploring <i class="fa-solid fa-arrow-right"></i></a>
  </div>
</main>
