<% layout("/layouts/boilerplate") %>
    <div class="row mt-3">
      <div class="col-8 offset-3">
        <h3> <%= listing.title %></h3>
      </div>
    <div class="card col-6 offset-3 listing-card">
      <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="...">
      <div class="card-body">
        <p class="card-text">Owned By : <i><%= listing.owner.username %></i></p>
        <p class="card-text"><%= listing.description %> </p>
          <p class="card-text">&#8377; <%= listing.price.toLocaleString("en-IN") %></p>
          <p class="card-text"><%= listing.location %> </p>
          <p class="card-text"><%= listing.country %></p>
      </div>
    </div>
    <br />
    <% if(currUser && listing.owner._id.equals(currUser._id)){ %>
    <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark col-1 offset-3 add-btn" style="z-index: 7;">Edit</a>
    <div class="btns">
      <form method="POST" style="margin-top: -2.3rem;margin-bottom: 1rem;margin-left: -6rem;" action="/listings/<%=listing._id%>?_method=DELETE" data-confirm data-confirm-title="Delete this stay?" data-confirm-message="This stay and its associated reviews will be permanently removed." data-confirm-action="Yes, delete stay">
        <button class="btn btn-dark offset-5 pp">Delete</button>
      </form>
    </div>
    <% } %>
    <div class="col-6 offset-3 mb-3 ">
      <hr>
      <% if(currUser){ %>
      <h4>Leave a Review</h4>
      <form action="/listings/<%=listing.id%>/reviews" method="post" novalidate class="needs-validation">
        <!-- <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
        </div> -->
        <div class="mb-3 mt-3">
        <label for="rating" class="form-label">Rating</label>
        <fieldset class="starability-slot">
          
          
          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
      </div>
        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
          <div class="invalid-feedback">
            please add some comments for review
          </div>
        </div>
        <button class="btn btn-outline-dark">Submit</button>
      </form>
     
      <hr>
      <% } %>
      <% if(listing.reviews.length>0){ %>
      <div class="row">
      <h4>All Reviews</h4>
      <% for( let review of listing.reviews){ %>
        <div class="card col-5 ms-3 mb-3">
          <div class="card-body">
            <h5 class="card-title mt-3">@<%= review.author.username%></h5>
            <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
            <p class="card-text"><%= review.comment %></p>
          </div>
          <form method="post" action="/listings/<%=listing.id%>/reviews/<%=review.id%>?_method=DELETE" data-confirm data-confirm-title="Delete this review?" data-confirm-message="This review will be permanently removed." data-confirm-action="Yes, delete review">
            <button class="btn btn-sm btn-dark mb-3 mt-3">Delete</button>
          </form>
        </div>
      <% } %>
    </div>
    <% } %>
    </div>
    <div class="col-6 offset-3 mb-3">
      <h3>Where you'll be</h3>
      <div
        id="map"
        data-map-token="<%= process.env.MAP_TOKEN || '' %>"
        data-coordinates="<%= JSON.stringify(listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates : []) %>"
        data-listing-title="<%= listing.title %>"
      ></div>
  </div>
  </div>
  <script>
    const mapElement = document.getElementById("map");
    const mapToken = mapElement.dataset.mapToken;
    const coordinates = JSON.parse(mapElement.dataset.coordinates);

    const validCoordinates = Array.isArray(coordinates)
      && coordinates.length === 2
      && coordinates.every((coordinate) => typeof coordinate === "number" && Number.isFinite(coordinate));

    if (typeof mapboxgl !== "undefined" && mapToken && validCoordinates) {
      mapboxgl.accessToken = mapToken;
      const map = new mapboxgl.Map({
        container: mapElement,
        style: "mapbox://styles/mapbox/streets-v12",
        center: coordinates,
        zoom: 9
      });
      const popupContent = document.createElement("div");
      const popupTitle = document.createElement("h4");
      const popupDescription = document.createElement("p");

      popupTitle.textContent = mapElement.dataset.listingTitle;
      popupDescription.textContent = "Exact location provided after booking";
      popupContent.append(popupTitle, popupDescription);

      new mapboxgl.Marker({ color: "#111310" })
        .setLngLat(coordinates)
        .setPopup(new mapboxgl.Popup({ offset: 25 }).setDOMContent(popupContent))
        .addTo(map);
    } else {
      mapElement.textContent = "Map unavailable. Configure a valid Mapbox token and listing location to enable it.";
    }
  </script>
<!-- <script src="/js/map.js"></script> -->