<div class="wander-toast-stack" aria-live="polite" aria-relevant="additions">
  <% if (success && success.length) { %>
    <div class="wander-toast wander-toast-success" role="status">
      <span class="wander-toast-icon" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
      <p class="wander-toast-message"><%= success %></p>
      <button class="wander-toast-close" type="button" aria-label="Dismiss notification"><i class="fa-solid fa-xmark"></i></button>
      <span class="wander-toast-timer" aria-hidden="true"></span>
    </div>
  <% } %>
  <% if (error && error.length) { %>
    <div class="wander-toast wander-toast-error" role="alert">
      <span class="wander-toast-icon" aria-hidden="true"><i class="fa-solid fa-exclamation"></i></span>
      <p class="wander-toast-message"><%= error %></p>
      <button class="wander-toast-close" type="button" aria-label="Dismiss notification"><i class="fa-solid fa-xmark"></i></button>
    </div>
  <% } %>
</div>
